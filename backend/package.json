{
  "name": "shieldcars-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API and production server for Shield Cars Ltd",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "build": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "nodemailer": "^10.0.13"
  }
}
